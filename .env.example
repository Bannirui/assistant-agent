# LLM Provider (DeepSeek)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding Provider (DashScope)
EMBED_PROVIDER=dashscope
EMBED_API_KEY=sk-your-dashscope-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3

# Application
COPILOT_ENV=development
COPILOT_LOG_LEVEL=DEBUG
COPILOT_MAX_AGENT_ITERATIONS=10

# Data paths
COPILOT_DATA_DIR=./data
COPILOT_SOP_DIR=./data/sop
COPILOT_KNOWLEDGE_DIR=./data/knowledge
# 向量库类型 qdrant/chroma/milvus
COPILOT_VECTOR_TYPE=qdrant
# 用Qdrant本地模式时 向量数据存储路径
COPILOT_QDRANT_PATH=./data/qdrant
# 数据库用哪个 sqlite/mysql
COPILOT_DB_TYPE=sqlite
# 要是用sqlite SOP标准流程维护在数据库
COPILOT_DB_PATH=./data/copilot.db
# 要是用mysql
COPILOT_DB_IP=ip
COPILOT_DB_PORT=port
COPILOT_DB_USER=user
COPILOT_DB_PWD=pwd

# Server
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8000

# 给Docker BuildKit配置代理
HTTP_PROXY=proxy(ip:port)
HTTPS_PROXY=proxy(ip:port)
NO_PROXY=localhost,127.0.0.1
