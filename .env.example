# DeepSeek API (LLM)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# DashScope API (Embedding)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Application
COPILOT_ENV=development
COPILOT_LOG_LEVEL=DEBUG
COPILOT_MAX_AGENT_ITERATIONS=10

# Data paths
COPILOT_DATA_DIR=./data
COPILOT_SOP_DIR=./data/sop
COPILOT_KNOWLEDGE_DIR=./data/knowledge
COPILOT_QDRANT_PATH=./data/qdrant

# Server
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8000
